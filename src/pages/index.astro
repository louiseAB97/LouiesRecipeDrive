---
import { getCollection } from "astro:content";
import Basis from "../layouts/Basis.astro";
import OverzichtPagina from "../components/OverzichtPagina.astro";
import { fotosPerRecept } from "../utils/fotos";

const recepten = await getCollection("recepten", ({ data }) => !data.concept);
const tags = [...new Set(recepten.flatMap((r) => r.data.tags))].sort();
---

<Basis
  titel="Louie's Recipe Drive"
  beschrijving="Alle recepten van Louie's Recipe Drive — verzameld, getest en opgeschreven door Louie."
>
  <OverzichtPagina recepten={recepten} fotos={fotosPerRecept()} tags={tags} />
</Basis>
