---
import Basis from "../layouts/Basis.astro";
---

<Basis titel="Page not found" beschrijving="This page does not exist.">
  <div class="niet-gevonden">
    <p class="code mono">404</p>
    <h1>This page does not exist</h1>
    <p class="muted">
      Maybe the recipe got eaten. Try again from the overview.
    </p>
    <a class="terug mono" href="/recipes">← All recipes</a>
  </div>
</Basis>

<style>
  .niet-gevonden {
    max-width: 34rem;
    padding: var(--ruimte-xl) 0;
  }

  .code {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: var(--ruimte-m);
  }

  .terug {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
  }
</style>
