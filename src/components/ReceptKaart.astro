---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  recept: CollectionEntry<"recipes">;
  foto?: ImageMetadata;
}

const { recept, foto } = Astro.props;
const { title, persons, price } = recept.data;
const meta = [
  persons ? `${persons} pers.` : null,
  price ? `± ${price}` : null,
]
  .filter(Boolean)
  .join(" · ");
---

<a class="kaart" href={`/recipes/${recept.id}`}>
  {
    foto ? (
      <Image
        src={foto}
        width={640}
        format="webp"
        alt={title}
        loading="lazy"
        class="kaart-foto"
      />
    ) : (
      <div class="kaart-vlak" aria-hidden="true" />
    )
  }
  <span class="kaart-titel">{title}</span>
  {meta && <span class="kaart-meta mono muted">{meta}</span>}
</a>

<style>
  .kaart {
    display: flex;
    flex-direction: column;
    gap: var(--ruimte-xs);
    text-decoration: none;
  }

  .kaart-foto,
  .kaart-vlak {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .kaart-vlak {
    background: var(--vlak);
  }

  .kaart-titel {
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
    transition: color 0.15s ease;
  }

  .kaart:hover .kaart-titel {
    color: var(--accent-hover);
  }

  .kaart-meta {
    font-size: 0.78rem;
  }
</style>
