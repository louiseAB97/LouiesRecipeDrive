---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" role="list">
      {tags.map((tag) => (
        <li>
          <a href={`/tag/${tag}`}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ruimte-s);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .tags a {
    color: var(--grijs);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .tags a:hover {
    color: var(--inkt);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
